+    def _scan_python(self) -> list:
+        """纯 Python（bleak）扫描：列出所有广播 manufacturer=0x5053 的设备。
+
+        供 Web UI「扫描附近设备」在 macOS 纯 Python 模式下使用，替代 Swift
+        `mac-image-transfer --list`（后者依赖无授权 skill_dir）。输出行含
+        id=<UUID>，与 Web UI 正则 /id=([0-9A-Fa-f-]{36})/ 对齐；macOS 上 bleak
+        的 addr 即 CoreBluetooth UUID。不做 screen/target/name 过滤——发现阶段
+        要能看到未绑定的卡片。卡片平时不广播，扫描前需唤醒（上电/长按按键）。
+        """
+        from bleak import BleakScanner
+
+        async def _discover():
+            devs = await BleakScanner.discover(timeout=8, return_adv=True)
+            lines = []
+            for addr, (dev, adv) in devs.items():
+                mfr = (adv.manufacturer_data or {})
+                if 0x5053 not in mfr:
+                    continue
+                name = (dev.name or adv.local_name or "").strip()
+                rssi = getattr(adv, "rssi", None)
+                line = f"id={addr} manufacturer=0x5053 name={name}"
+                if rssi is not None:
+                    line += f" rssi={rssi}"
+                lines.append(line)
+            return lines
+
+        return asyncio.run(_discover())
+
