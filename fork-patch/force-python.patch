+    def _scan_python(self) -> list:
+        """纯 Python（bleak）扫描：列出所有广播 manufacturer=0x5053 的设备。
+
+        供 Web UI「扫描附近设备」在 macOS 纯 Python 模式下使用，替代 Swift
+        `mac-image-transfer --list`（后者依赖无授权 skill_dir）。输出行含
+        id=<UUID>，与 Web UI 正则 /id=([0-9A-Fa-f-]{36})/ 对齐；macOS 上 bleak
+        的 addr 即 CoreBluetooth UUID。不做 screen/target/name 过滤——发现阶段
+        要能看到未绑定的卡片。卡片平时不广播，扫描前需唤醒（上电/长按按键）。
+        """
+        from bleak import BleakScanner
+
+        async def _discover():
+            devs = await BleakScanner.discover(timeout=8, return_adv=True)
+            lines = []
+            for addr, (dev, adv) in devs.items():
+                mfr = (adv.manufacturer_data or {})
+                if 0x5053 not in mfr:
+                    continue
+                name = (dev.name or adv.local_name or "").strip()
+                rssi = getattr(adv, "rssi", None)
+                line = f"id={addr} manufacturer=0x5053 name={name}"
+                if rssi is not None:
+                    line += f" rssi={rssi}"
+                lines.append(line)
+            return lines
+
+        return asyncio.run(_discover())
+
+    async def _pair_python(self, device_id: str, log=None) -> dict:
+        """纯 Python（bleak）配对，复刻上游 Swift `--pair` 的“检测配对窗口→连接→系统配对”。
+
+        原版用 mac-image-transfer --pair（依赖无授权 skill_dir，纯 Python 模式必然 exit 127）。
+        这里改用 bleak：macOS 走 CoreBluetooth，在卡片配对窗口（长按背面 5 秒，广播
+        flags&0x02）里连接并触碰控制点，会触发系统蓝牙配对框；用户点「配对」即完成绑定。
+        窗口判据与 _scan_card 一致（厂商 0x5053 / screen 0x134C / flags&0x02）。log 回调把
+        每一步流式喂给 Web UI（pair_session）。失败兜底引导到 系统设置→蓝牙 手动配对。
+        """
+        import bleak
+        from bleak import BleakClient
+
+        control_uuids = ("0000fef1-0000-1000-8000-00805f9b34fb",
+                         "0000fdf1-0000-1000-8000-00805f9b34fb")
+
+        def _log(m):
+            _LOGGER.info("%s", m)
+            if log:
+                log(m)
+
+        target = (device_id or "").upper()
+        _log("等待卡片进入配对窗口…请长按卡片背面按钮 5 秒（随后 macOS 会弹出蓝牙配对框，请点「配对」）")
+
+        # 1) 等配对窗口：最多 ~90 秒，每轮 bleak 扫描 6 秒（与 _scan_card 同一判据）
+        device = None
+        deadline = time.time() + 90
+        while time.time() < deadline and not self._stop.is_set():
+            try:
+                devs = await bleak.BleakScanner.discover(timeout=6, return_adv=True)
+            except Exception as e:
+                _log(f"扫描出错：{e}")
+                devs = {}
+            for addr, (dev, adv) in devs.items():
+                data = (adv.manufacturer_data or {}).get(0x5053)
+                if not data or len(data) < 5:
+                    continue
+                if (data[0] | (data[4] << 8)) != 0x134C:
+                    continue
+                name = (dev.name or adv.local_name or "")
+                if target and str(addr).upper() != target and "todoo" not in name.lower():
+                    continue
+                if data[1] & 0x02:
+                    device = dev
+                    break
+            if device:
+                break
+            await asyncio.sleep(1)
+
+        if not device:
+            msg = ("没等到配对窗口：请确认卡片已唤醒，长按背面按钮 5 秒进入配对模式后重试；"
+                   "也可到 系统设置→蓝牙 手动配对 TodooCard。")
+            _log(msg)
+            return {"ok": False, "output": msg, "message": msg}
+
+        # 2) 窗口内连接 → 触发 macOS 系统配对（加密握手）
+        _log(f"检测到配对窗口（{device.address}），正在连接以完成系统配对…")
+        try:
+            async with BLE_GUARD:
+                async with BleakClient(device, timeout=30) as client:
+                    _log("已连接，正在完成加密配对…若弹出系统蓝牙配对框，请点「配对」")
+                    control = next((c for s in client.services for c in s.characteristics
+                                    if c.uuid.lower() in control_uuids), None)
+                    if control:
+                        # 触碰控制点（请求 block size）强制加密握手，触发系统配对
+                        try:
+                            await client.write_gatt_char(control, bytes([0x01]), response=True)
+                        except Exception as e:
+                            _log(f"控制点写入：{e}")
+                    # 留出时间让系统配对框完成绑定
+                    await asyncio.sleep(3)
+            msg = "配对完成"
+            _log(msg)
+            return {"ok": True, "output": msg, "message": msg}
+        except Exception as e:
+            msg = (f"纯 Python 配对失败：{e}。请长按卡片背面按钮 5 秒后重试，"
+                   f"或到 系统设置→蓝牙 手动配对 TodooCard。")
+            _log(msg)
+            return {"ok": False, "output": msg, "message": msg}
+
